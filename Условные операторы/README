}



static void R1Task42()
{
    Console.Write("Введите число: "); int n = int.Parse(Console.ReadLine());
    int root = (int)Math.Sqrt(n);
    if (root * root == n) Console.WriteLine("Полный квадрат."); else Console.WriteLine("Не полный квадрат.");
}



